{
  "name": "ossature",
  "version": "3.0.0",
  "private": true,
  "description": "OSSATURE — plateforme de gestion IPCM BOUTEMA",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node server/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test server/tests/*.test.js",
    "remigrate": "node scripts/remigrate.mjs",
    "build:demo": "vite build -c vite.demo.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
